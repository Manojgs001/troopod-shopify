<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#eee7fb">
  <title>{{ page_title }} - {{ shop.name }}</title>
  <meta name="description" content="{{ page_description | default: shop.description | escape }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ 'purelane-base.css' | asset_url | stylesheet_tag }}
  {{ 'purelane-base.js' | asset_url | script_tag }}
</head>
<body>
  <div class="scenes" id="scenes" data-d="1">
    <div class="scene s1 on"></div>
    <div class="scene s2"></div>
    <div class="scene s3"></div>
    <div class="scene s4"></div>
    <div class="water" id="water">
      <!-- wl-a SVG water layer -->
      <div class="wl wl-a">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="cg-a" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
              <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
              <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
              <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
              <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
            </linearGradient>
            <filter id="wf-a" x="-12%" y="-12%" width="124%" height="124%">
              <feTurbulence type="fractalNoise" baseFrequency="0.0022 0.019" numOctaves="3" seed="21" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="72" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#wf-a)">
            <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235 Q1033 201 1143 213 Q1253 232 1363 215 Q1473 261 1583 238 Q1694 248 1804 250" stroke="url(#cg-a)" stroke-width="1.7" fill="none" opacity="0.45" stroke-linecap="round"/>
            <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247 Q1324 277 1494 262 Q1664 267 1833 269" stroke="url(#cg-a)" stroke-width="5.1" fill="none" opacity="0.23" stroke-linecap="round"/>
            <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721 Q1262 674 1387 692 Q1512 716 1636 694" stroke="url(#cg-a)" stroke-width="5.7" fill="none" opacity="0.37" stroke-linecap="round"/>
            <path d="M140 308 Q297 310 454 302 Q611 321 769 312 Q926 314 1083 316 Q1240 298 1397 309 Q1555 295 1712 300" stroke="url(#cg-a)" stroke-width="5.5" fill="none" opacity="0.47" stroke-linecap="round"/>
            <path d="M570 422 Q687 462 805 437 Q922 436 1039 446 Q1156 391 1274 423 Q1391 388 1508 398 Q1625 432 1742 406" stroke="url(#cg-a)" stroke-width="2.3" fill="none" opacity="0.25" stroke-linecap="round"/>
          </g>
        </svg>
      </div>
      <!-- wl-b: lighter water layer -->
      <div class="wl wl-b">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="cg-b" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#eafff4" stop-opacity="0"/>
              <stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/>
              <stop offset=".5" stop-color="#ffffff" stop-opacity="1"/>
              <stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/>
              <stop offset="1" stop-color="#eafff4" stop-opacity="0"/>
            </linearGradient>
            <filter id="wf-b" x="-12%" y="-12%" width="124%" height="124%">
              <feTurbulence type="fractalNoise" baseFrequency="0.005 0.031" numOctaves="2" seed="47" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="46" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#wf-b)">
            <path d="M355 217 Q442 234 529 234 Q616 202 703 222 Q790 190 877 203 Q964 215 1051 202 Q1138 242 1225 221" stroke="url(#cg-b)" stroke-width="3.4" fill="none" opacity="0.17" stroke-linecap="round"/>
            <path d="M160 723 Q278 720 396 713 Q514 738 633 725 Q751 735 869 734 Q987 715 1105 728 Q1223 706 1341 715" stroke="url(#cg-b)" stroke-width="1.1" fill="none" opacity="0.17" stroke-linecap="round"/>
            <path d="M583 59 Q725 41 867 59 Q1009 41 1150 46 Q1292 65 1434 51 Q1575 81 1717 67" stroke="url(#cg-b)" stroke-width="1.4" fill="none" opacity="0.15" stroke-linecap="round"/>
          </g>
        </svg>
      </div>
      <!-- wl-c: shaft/light rays -->
      <div class="wl wl-c">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="sg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f4fff9" stop-opacity=".85"/>
              <stop offset=".38" stop-color="#dcf6e7" stop-opacity=".28"/>
              <stop offset="1" stop-color="#d4f2e2" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <g>
            <polygon points="95,-80 152,-80 517,1180 439,1180" fill="url(#sg)" opacity="0.26"/>
            <polygon points="433,-80 491,-80 885,1180 807,1180" fill="url(#sg)" opacity="0.41"/>
            <polygon points="751,-80 919,-80 1180,1180 953,1180" fill="url(#sg)" opacity="0.31"/>
            <polygon points="1048,-80 1135,-80 1400,1180 1282,1180" fill="url(#sg)" opacity="0.28"/>
            <polygon points="1366,-80 1520,-80 1898,1180 1690,1180" fill="url(#sg)" opacity="0.28"/>
          </g>
        </svg>
      </div>
      <!-- wl-s: surface shimmer -->
      <div class="wl wl-s">
        <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <linearGradient id="sf" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#ffffff" stop-opacity=".55"/>
              <stop offset=".55" stop-color="#e8fff2" stop-opacity=".16"/>
              <stop offset="1" stop-color="#e8fff2" stop-opacity="0"/>
            </linearGradient>
            <filter id="sfw" x="-10%" y="-40%" width="120%" height="180%">
              <feTurbulence type="fractalNoise" baseFrequency="0.004 0.05" numOctaves="2" seed="9" result="n"/>
              <feDisplacementMap in="SourceGraphic" in2="n" scale="30" xChannelSelector="R" yChannelSelector="G"/>
            </filter>
          </defs>
          <g filter="url(#sfw)">
            <rect x="-100" y="-40" width="2000" height="150" fill="url(#sf)"/>
            <rect x="-100" y="60" width="2000" height="60" fill="url(#sf)" opacity=".5"/>
          </g>
        </svg>
      </div>
      <!-- bubbles -->
      <div class="bub">
        <span style="--x:91.9%;--s:6.7px;--dur:21.5s;--dly:19.0s;--drift:-11px"></span>
        <span style="--x:43.4%;--s:5.7px;--dur:26.8s;--dly:16.1s;--drift:-11px"></span>
        <span style="--x:96.6%;--s:6.2px;--dur:13.7s;--dly:10.3s;--drift:38px"></span>
        <span style="--x:6.0%;--s:3.6px;--dur:24.4s;--dly:10.6s;--drift:3px"></span>
        <span style="--x:70.3%;--s:3.3px;--dur:20.9s;--dly:9.2s;--drift:-39px"></span>
        <span style="--x:67.7%;--s:4.0px;--dur:27.0s;--dly:16.5s;--drift:-5px"></span>
        <span style="--x:2.1%;--s:7.1px;--dur:22.0s;--dly:3.1s;--drift:-37px"></span>
        <span style="--x:69.4%;--s:8.1px;--dur:21.9s;--dly:10.7s;--drift:-24px"></span>
        <span style="--x:64.1%;--s:8.2px;--dur:17.3s;--dly:9.0s;--drift:2px"></span>
        <span style="--x:21.8%;--s:7.1px;--dur:15.7s;--dly:18.4s;--drift:-13px"></span>
      </div>
    </div>
    <div class="vig"></div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="track">
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat &#x20B9;499</b></span>
      <span>Free shipping <b>on every bundle across India</b></span>
      <span>100% plant-based <b>and non-toxic</b></span>
      <span>Loved by <b>30,000+ happy homes</b></span>
      <span>Buy 3 <b>at flat &#x20B9;499</b></span>
    </div>
  </div>

  <header id="hdr">
    <div class="navpill glass">
      <a class="brand" href="/" aria-label="Purelane home">
        <span class="mark">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
            <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
            <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
          </svg>
        </span>
        <span class="txt">
          <span class="n1">Purelane</span>
          <span class="n2">Clean, simply</span>
        </span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="/">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      </nav>
      <div class="navtools">
        <button class="ico hide-s" aria-label="Search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <a href="/account" class="ico hide-s" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
        </a>
        <a href="/cart" class="ico" aria-label="Cart, {{ cart.item_count }} items">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
          {% if cart.item_count > 0 %}
            <span class="dot">{{ cart.item_count }}</span>
          {% endif %}
        </a>
        <button class="ico burger" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <nav class="rail" aria-label="Section progress">
    <a href="#top" class="on" aria-label="Hero"></a>
    <a href="#reviews" aria-label="Reviews"></a>
    <a href="#shop" aria-label="Shop"></a>
    <a href="#combos" aria-label="Combos"></a>
    <a href="#bundles" aria-label="Bundles"></a>
  </nav>

  <main id="top">{{ content_for_layout }}</main>

  <footer data-scene="4">
    <div class="wrap">
      <div class="fgrid">
        <div class="fcol">
          <a class="brand" href="/" style="margin-bottom:16px">
            <span class="mark">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
                <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                <path d="M12 21v-6"/>
              </svg>
            </span>
            <span class="txt"><span class="n1">Purelane</span><span class="n2">Clean, simply</span></span>
          </a>
          <p style="max-width:30ch;color:var(--paper-2);font-size:13.5px">Effective cleaning, powered by nature. Made for Indian homes since day one.</p>
        </div>
        <div class="fcol">
          <h5>Shop</h5>
          <a href="/collections/all">Bestsellers</a>
          <a href="/collections/kitchen">Kitchen</a>
          <a href="/collections/laundry">Laundry</a>
          <a href="/collections/home">Home</a>
          <a href="/collections/skin">Skin</a>
          <a href="#bundles">Starter kits</a>
        </div>
        <div class="fcol">
          <h5>About</h5>
          <a href="#how">How it works</a>
          <a href="#ingredients">Sustainability</a>
          <a href="#">FAQs</a>
          <a href="#reviews">Reviews</a>
        </div>
        <div class="fcol">
          <h5>Get in touch</h5>
          <a href="mailto:hello@purelane.com">hello@purelane.com</a>
          <a href="tel:+919930123234">+91 9930 123 234</a>
          <p style="font-size:12px;color:rgba(236,230,247,.5)">Purelane Eco Products Pvt Ltd</p>
        </div>
      </div>
      <div class="fbot">
        <span>&copy; {{ 'now' | date: '%Y' }} Purelane Eco Products Private Limited</span>
        <span>Privacy &middot; Terms &middot; Refunds &middot; Contact</span>
      </div>
    </div>
  </footer>

  <div class="sticky">
    <span class="lbl"><b>Pick any 3, pay &#x20B9;499</b><span>Free shipping, always</span></span>
    <a class="btn btn-primary btn-sm" href="#bundles">Build bundle</a>
  </div>
</body>
</html>
