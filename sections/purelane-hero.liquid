{% comment %}
  Purelane Hero Section
{% endcomment %}

{{ 'purelane-base.css' | asset_url | stylesheet_tag }}

<style>
/* hero */
.hero{position:relative;z-index:2;min-height:100svh;display:flex;align-items:flex-end;padding:150px 0 var(--sec-y)}
.hero::before{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(102deg,rgba(1,45,42,.68) 0%,rgba(1,45,42,.40) 30%,rgba(1,45,42,.10) 52%,transparent 66%)}
@media(max-width:900px){.hero::before{
  background:linear-gradient(180deg,rgba(1,45,42,.44) 0%,rgba(1,45,42,.22) 34%,rgba(1,40,38,.60) 100%)}}
.hero-grid{max-width:var(--maxw);margin:0 auto;padding:0 18px;width:100%;position:relative;z-index:2}
.hero-copy{max-width:600px;position:relative;z-index:3}
.hero h1{margin-bottom:20px;text-shadow:0 6px 40px rgba(2,20,19,.55)}
.hero-cta{display:flex;gap:11px;flex-wrap:wrap;margin-top:26px}
/* hero-prod */
.hero-prod{position:absolute;right:2%;bottom:28px;width:min(50vw,560px);z-index:2;
  filter:drop-shadow(0 34px 54px rgba(2,20,19,.6))}
@media(max-width:1200px){
  .hero-copy{max-width:470px}
  .hero-prod{width:min(44vw,440px);right:3%}
}
@media(max-width:900px){
  .hero{align-items:flex-end;padding-top:132px}
  .hero-copy{max-width:none}
  .hero-prod{position:relative;right:auto;bottom:auto;width:min(88vw,420px);margin:20px auto 0}
}
/* badge rail */
.badges{position:absolute;right:18px;top:50%;transform:translateY(-50%);width:96px;z-index:4;
  display:flex;flex-direction:column;gap:2px;padding:12px 8px;border-radius:20px}
.badge{text-align:center;padding:11px 4px}
.badge+.badge{border-top:1px solid rgba(236,230,247,.14)}
.badge .bi{width:38px;height:38px;margin:0 auto 8px;border-radius:50%;display:grid;place-items:center;
  background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.22);color:var(--accent)}
.badge .bi svg{width:19px;height:19px}
.badge span{display:block;font-size:8.5px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--paper-2);line-height:1.34}
@media(max-width:900px){.badges{display:none}}
/* mobile badge strip */
.badgestrip{display:flex;gap:8px;margin-top:24px}
.badgestrip div{flex:1;text-align:center;padding:11px 6px;border-radius:14px;font-size:8.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-2);line-height:1.3}
.badgestrip svg{width:18px;height:18px;margin:0 auto 6px;color:var(--accent)}
@media(min-width:901px){.badgestrip{display:none}}
/* hero product stage */
.hstage{position:relative;width:100%;height:clamp(380px,74svh,680px)}
.hslide{position:absolute;inset:0;display:flex;align-items:flex-end;justify-content:flex-end;
  padding-right:2%;opacity:0;pointer-events:none;transition:opacity .85s var(--ease)}
.hslide.on{opacity:1}
.hp{position:relative;width:auto;flex:0 0 auto;
  background-repeat:no-repeat;background-position:center bottom;background-size:contain;
  opacity:0;transform:translateY(28px) scale(.94);
  transition:opacity .8s var(--ease),transform .8s var(--ease);
  filter:drop-shadow(0 26px 40px rgba(1,22,20,.66))}
.hslide.on .hp{opacity:1;transform:none}
.hslide.on .hp.d1{transition-delay:.06s}
.hslide.on .hp.d2{transition-delay:.30s}
.hslide.on .hp.d3{transition-delay:.54s}
.hs1 .a{height:100%;z-index:3}
.hs2 .a{height:80%;margin-right:-8%;z-index:1}
.hs2 .b{height:97%;z-index:3}
.hs3 .a{height:75%;margin-right:-8%;z-index:1;order:1}
.hs3 .c{height:97%;z-index:3;order:2}
.hs3 .b{height:79%;margin-left:-8%;z-index:2;order:3}
/* price flag */
.ptag{position:absolute;left:0;bottom:2%;z-index:6;padding:11px 14px 12px;border-radius:16px;max-width:52%;
  opacity:0;transform:translateY(16px);
  transition:opacity .8s var(--ease) .62s,transform .8s var(--ease) .62s}
.hslide.on .ptag{opacity:1;transform:none}
.ptag .lbl{display:block;font-size:9px;font-weight:800;letter-spacing:.17em;text-transform:uppercase;color:var(--accent)}
.ptag .val{display:flex;align-items:baseline;gap:7px;margin-top:5px}
.ptag .val strong{font-family:'Outfit',sans-serif;font-size:23px;font-weight:800;letter-spacing:-.02em;color:var(--surface);line-height:1}
.ptag .val s{font-size:12px;color:var(--paper-3)}
.ptag .cut{display:inline-block;margin-top:7px;font-size:8.4px;font-weight:800;letter-spacing:.11em;text-transform:uppercase;
  padding:3px 8px;border-radius:999px;background:rgba(240,160,60,.20);border:1px solid rgba(240,160,60,.38);color:var(--accent)}
/* stage dots */
.hdots{display:flex;gap:7px;justify-content:center;align-items:center;margin-top:8px}
.hdots button{width:6px;height:6px;padding:0;border-radius:50%;background:rgba(236,230,247,.28);transition:.4s var(--ease);border:none;cursor:pointer}
.hdots button.on{background:var(--accent);width:20px;border-radius:999px}
.hdots button:hover{background:rgba(236,230,247,.5)}
@media(max-width:900px){
  .hstage{height:clamp(300px,44svh,430px)}
  .ptag{padding:9px 12px 10px;border-radius:14px;max-width:58%}
  .ptag .val strong{font-size:20px}
}
@media(prefers-reduced-motion:reduce){
  .hslide,.hp,.ptag{transition:none}
}
</style>

<section class="hero" data-scene="1">
  {% render 'purelane-scene-bg' %}
  
  <div class="hero-grid">
    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        </span>
        <span>{{ section.settings.badge_1_text | newline_to_br }}</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
        </span>
        <span>{{ section.settings.badge_2_text | newline_to_br }}</span>
      </div>
      <div class="badge">
        <span class="bi">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
        </span>
        <span>{{ section.settings.badge_3_text | newline_to_br }}</span>
      </div>
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">
        {{ section.settings.heading | newline_to_br }}
        <span class="lime">{{ section.settings.heading_highlight }}</span>
      </h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.subheading }}</p>
      
      <div class="hero-cta rv rv-d3">
        {% if section.settings.cta_primary_label != blank %}
          <a class="btn btn-primary" href="{{ section.settings.cta_primary_url }}">
            {{ section.settings.cta_primary_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        {% endif %}
        
        {% if section.settings.cta_secondary_label != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.cta_secondary_url }}">
            {{ section.settings.cta_secondary_label }}
          </a>
        {% endif %}
      </div>

      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          {{ section.settings.badge_1_text | newline_to_br }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          {{ section.settings.badge_2_text | newline_to_br }}
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          {{ section.settings.badge_3_text | newline_to_br }}
        </div>
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        <!-- Slide 1: 1 product (kbtl) -->
        <div class="hslide hs1 on" data-n="1">
          <span class="hp p-kbtl a d1" role="img" aria-label="Purelane foaming kitchen cleaner spray bottle"></span>
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide_1_label }}</span>
            <span class="val"><strong>{{ section.settings.slide_1_price }}</strong><s>{{ section.settings.slide_1_mrp }}</s></span>
            <span class="cut">{{ section.settings.slide_1_save_label }}</span>
          </div>
        </div>
        <!-- Slide 2: 2 products (tbtl + kbtl) -->
        <div class="hslide hs2" data-n="2">
          <span class="hp p-tbtl a d1" role="img" aria-label="Purelane foaming toilet cleaner"></span>
          <span class="hp p-kbtl b d2" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide_2_label }}</span>
            <span class="val"><strong>{{ section.settings.slide_2_price }}</strong><s>{{ section.settings.slide_2_mrp }}</s></span>
            <span class="cut">{{ section.settings.slide_2_save_label }}</span>
          </div>
        </div>
        <!-- Slide 3: 3 products (tbtl + mbtl + kbtl) -->
        <div class="hslide hs3" data-n="3">
          <span class="hp p-tbtl a d1" role="img" aria-label="Purelane foaming toilet cleaner"></span>
          <span class="hp p-mbtl b d2" role="img" aria-label="Purelane foaming multi-surface cleaner"></span>
          <span class="hp p-kbtl c d3" role="img" aria-label="Purelane foaming kitchen cleaner"></span>
          <div class="glass-2 ptag">
            <span class="lbl">{{ section.settings.slide_3_label }}</span>
            <span class="val"><strong>{{ section.settings.slide_3_price }}</strong><s>{{ section.settings.slide_3_mrp }}</s></span>
            <span class="cut">{{ section.settings.slide_3_save_label }}</span>
          </div>
        </div>
      </div>
      <div class="hdots" id="hdots">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" aria-label="Show 2 products"></button>
        <button type="button" aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.section-purelane-hero');
    if (!section) return;
    
    const dots = section.querySelectorAll('#hdots button');
    const slides = section.querySelectorAll('.hslide');
    if (dots.length === 0 || slides.length === 0) return;

    let currentIndex = 0;
    let intervalId;

    function showSlide(index) {
      slides.forEach(slide => slide.classList.remove('on'));
      dots.forEach(dot => dot.classList.remove('on'));
      
      slides[index].classList.add('on');
      dots[index].classList.add('on');
    }

    function nextSlide() {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
    }

    function startAutoSlide() {
      stopAutoSlide();
      intervalId = setInterval(nextSlide, 4500);
    }

    function stopAutoSlide() {
      if (intervalId) {
        clearInterval(intervalId);
      }
    }

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentIndex = index;
        showSlide(currentIndex);
        startAutoSlide(); // Reset timer on manual interaction
      });
    });

    startAutoSlide();
  });
</script>

