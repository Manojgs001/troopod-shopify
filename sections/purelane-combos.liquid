<style>
.comborail{display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;
  margin:0 -18px;padding:4px 18px 14px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.comborail::-webkit-scrollbar{display:none}
.combo{flex:0 0 302px;scroll-snap-align:start;display:flex;flex-direction:column;padding:0;transition:.4s var(--ease)}
.combo:hover{transform:translateY(-5px)}
.combo.hero-combo{border-color:rgba(240,160,60,.42);box-shadow:0 26px 74px rgba(18,12,34,.44),0 0 0 1px rgba(240,160,60,.2),var(--g-inset)}
.combo .tray{padding:14px 14px 13px;border-bottom:1px solid rgba(236,230,247,.13);
  display:flex;align-items:flex-end;justify-content:center;gap:6px;min-height:150px}
.combo .tray .pimg{height:118px;filter:drop-shadow(0 12px 18px rgba(1,24,22,.5))}
.combo .tray .pimg.main{height:136px}
.combo-body{padding:16px 16px 14px;display:flex;flex-direction:column;flex:1}
.combo-tag{display:inline-block;font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  padding:4px 10px;border-radius:999px;margin-bottom:10px;
  background:rgba(240,160,60,.16);border:1px solid rgba(240,160,60,.30);color:var(--accent)}
.combo h4{font-family:'Outfit',sans-serif;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;
  color:var(--surface);line-height:1.14;margin-bottom:6px}
.combo .sub{font-size:12.5px;color:var(--paper-2);margin-bottom:14px;flex:1}
.combo-pr{display:flex;align-items:baseline;gap:8px;margin-bottom:14px}
.combo-pr strong{font-family:'Outfit',sans-serif;font-size:20px;color:var(--accent);font-weight:800}
.combo-pr s{font-size:12px;color:var(--paper-3)}
.combo-pr em{font-style:normal;font-size:9.5px;font-weight:800;letter-spacing:.1em;color:var(--accent)}
.combo .btn{width:100%;justify-content:center}
</style>

<section id="combos" class="section">
  <div class="wrap">
    <div class="sec-head rv">
      {% if section.settings.kicker != blank %}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="p-lg">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>
    
    <div class="comborail">
      {% for block in section.blocks %}
        <div class="glass combo rv rv-d{{ forloop.index | at_most: 5 }} {% if block.settings.is_featured %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
          <div class="tray">
            {% assign pimgs = block.settings.product_images | split: ' ' %}
            {% for img in pimgs %}
              {% assign is_main = false %}
              {% if block.settings.main_image == img %}
                {% assign is_main = true %}
              {% endif %}
              <span class="pimg {{ img }}{% if is_main %} main{% endif %}" role="img" aria-label="{{ img | replace: 'p-', '' | capitalize }} product"></span>
            {% endfor %}
          </div>
          <div class="combo-body">
            <div>
              {% if block.settings.tag_label != blank %}
                <span class="combo-tag">{{ block.settings.tag_label }}</span>
              {% endif %}
              <h4>{{ block.settings.title }}</h4>
              <p class="sub">{{ block.settings.subtitle }}</p>
            </div>
            <div>
              <div class="combo-pr">
                <strong>{{ block.settings.price }}</strong>
                {% if block.settings.compare_price != blank %}
                  <s>{{ block.settings.compare_price }}</s>
                {% endif %}
                {% if block.settings.save_label != blank %}
                  <em>{{ block.settings.save_label }}</em>
                {% endif %}
              </div>
              <a href="{{ block.settings.cta_url | default: '#' }}" class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %} btn-sm">{{ block.settings.cta_label }}</a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Our top picks"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best-selling combos"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Card",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "tag_label",
          "label": "Tag Label",
          "default": "Bestseller"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare at Price"
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "Save Label",
          "default": "Save ₹249"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "default": "Shop this combo"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Featured (Gold Border)",
          "default": false
        },
        {
          "type": "text",
          "id": "product_images",
          "label": "Product Images Classes",
          "info": "Space-separated class names e.g., 'p-kitchen p-tap'"
        },
        {
          "type": "text",
          "id": "main_image",
          "label": "Main Image Class",
          "info": "Which image class gets the main treatment e.g., 'p-kitchen'"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Best-Selling Combos",
      "blocks": [
        {
          "type": "combo",
          "settings": {
            "title": "Kitchen & Bath Essential",
            "subtitle": "Everything you need for clean water at home.",
            "price": "₹1,499",
            "compare_price": "₹1,999",
            "is_featured": true,
            "product_images": "p-kitchen p-tap",
            "main_image": "p-kitchen"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Shower Duo",
            "subtitle": "Double the protection for your hair.",
            "price": "₹1,299",
            "compare_price": "₹1,599",
            "is_featured": false,
            "product_images": "p-shower p-shower",
            "main_image": "p-shower"
          }
        },
        {
          "type": "combo",
          "settings": {
            "title": "Whole Home Pro",
            "subtitle": "Complete water care for every tap.",
            "price": "₹2,499",
            "compare_price": "₹3,499",
            "is_featured": false,
            "product_images": "p-kitchen p-shower p-tap",
            "main_image": "p-kitchen"
          }
        }
      ]
    }
  ]
}
{% endschema %}
