        },
        {
          "type": "number",
          "id": "qty_number",
          "label": "Quantity number",
          "default": 2
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product_note",
          "label": "Per product note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Is most popular/best?",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL",
          "default": "/collections/all"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "product_images",
          "label": "Product images (CSS classes)",
          "default": "p-combo2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag_label": "Starter",
            "qty_number": 2,
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_note": "Flat ₹174 per product",
            "is_best": false,
            "feature_1": "Pick any two products",
            "feature_2": "Free shipping across India",
            "product_images": "p-combo2"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_label": "Most popular",
            "qty_number": 3,
            "price": "₹499",
            "compare_price": "₹897",
            "per_product_note": "Flat ₹166 per product",
            "is_best": true,
            "feature_1": "Pick any three products",
            "feature_2": "Free shipping across India",
            "product_images": "p-kitchen p-tap p-dish"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_label": "Whole home",
            "qty_number": 5,
            "price": "₹799",
            "compare_price": "₹1495",
            "per_product_note": "Flat ₹160 per product",
            "is_best": false,
            "feature_1": "Pick any five products",
            "feature_2": "Free shipping across India",
            "product_images": "p-1 p-2 p-3 p-4 p-5"
