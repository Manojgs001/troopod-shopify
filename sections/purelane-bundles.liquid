<style>
.tiers{display:grid;gap:14px;grid-template-columns:1fr;padding:0 18px}
@media(min-width:760px){.tiers{grid-template-columns:repeat(3,1fr);max-width:1180px;margin:0 auto}}
.tier{padding:24px 22px;transition:.4s var(--ease)}
.tier:hover{transform:translateY(-5px)}
.tier.best{border-color:rgba(240,160,60,.44);box-shadow:0 26px 74px rgba(18,12,34,.44),0 0 0 1px rgba(240,160,60,.2),var(--g-inset)}
.tier .tag{display:inline-block;font-size:9.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;padding:5px 11px;border-radius:999px;margin-bottom:14px;
  background:rgba(240,160,60,.18);border:1px solid rgba(240,160,60,.34);color:var(--accent)}
.tier .qty{font-family:'Outfit',sans-serif;font-weight:800;font-size:52px;line-height:.9;color:var(--surface);letter-spacing:-.03em}
.tier .qty small{font-size:14px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-3);display:block;margin-top:6px}
.tier .price{font-family:'Outfit',sans-serif;font-weight:700;font-size:27px;color:var(--accent);margin:16px 0 4px}
.tier .price s{font-size:14px;color:var(--paper-3);font-weight:500;margin-left:8px}
.tier ul{list-style:none;margin:16px 0 20px;display:grid;gap:8px}
.tier li{display:flex;gap:9px;font-size:13px;color:var(--paper-2)}
.tier li svg{width:14px;height:14px;color:var(--accent);flex:0 0 auto;margin-top:4px}
.tier .btn{width:100%;justify-content:center}
.tierpix{display:flex;align-items:flex-end;justify-content:center;gap:4px;height:120px;margin:14px 0}
.tierpix .pimg{height:100px}
.tierpix.five .pimg{height:80px}
.tierpix .pimg:nth-child(2){height:110px}
.tierpix.five .pimg:nth-child(3){height:90px}
</style>

<section class="sec" id="bundles" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
    </div>
  </div>
  <div class="tiers">
    {%- for block in section.blocks -%}
      <article class="glass tier rv{% if block.settings.is_best %} best{% endif %} rv-d{{ forloop.index }}" {{ block.shopify_attributes }}>
        <span class="tag">{{ block.settings.tag_label }}</span>
        
        {% assign img_classes = block.settings.product_images | split: ' ' %}
        <div class="tierpix{% if img_classes.size == 5 %} five{% endif %}" aria-hidden="true">
          {% for img_class in img_classes %}
            <span class="pimg {{ img_class }}"></span>
          {% endfor %}
        </div>
        
        <div class="qty">{{ block.settings.qty_number }}<small>Products</small></div>
        <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
        <p class="body-s" style="font-size:12px">{{ block.settings.per_product_note }}</p>
        
        <ul>
          {% if block.settings.feature_1 != blank %}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
          {% endif %}
          {% if block.settings.feature_2 != blank %}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
          {% endif %}
          {% if block.settings.feature_3 != blank %}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
          {% endif %}
        </ul>
        
        <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.cta_url }}">
          {{ block.settings.cta_label }}
          {% if block.settings.is_best %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          {% endif %}
        </a>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix and match across kitchen, laundry, home and skin..."
    }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag_label",
